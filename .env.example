# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (D'Calabash Hotel Database & Storage)
# Obtain from your Supabase Project Settings > API:
# https://supabase.com/dashboard/project/<project-ref>/settings/api
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Server-Side Only Service Role Key (Do NOT expose in client code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# TRANSACTIONAL NOTIFICATIONS (Optional SMTP / Resend)
RESEND_API_KEY="re_123456789"
NOTIFICATION_SENDER_EMAIL="admin@dcalabashhotel.co"
